@@ -648,3 +648,39 @@
 .settings-overlay.peek { background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; transition: background .25s, backdrop-filter .25s, opacity .3s; }
 .settings-overlay.peek .settings-win { opacity: .14; transform: scale(.985); transition: opacity .25s ease, transform .4s var(--ease); }
 .settings-overlay.peek .settings-win:hover { opacity: .14; }
+
+/* ============ Right-click menu ============ */
+.ctx {
+  position: fixed; z-index: 70; min-width: 230px; max-width: 300px;
+  padding: 6px; border-radius: 16px;
+  background: rgba(28, 28, 38, .72);
+  backdrop-filter: blur(30px) saturate(170%); -webkit-backdrop-filter: blur(30px) saturate(170%);
+  box-shadow: 0 18px 50px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .2);
+  animation: ctxIn .18s var(--ease) both; transform-origin: top left;
+  user-select: none;
+}
+.ctx[hidden] { display: none; }
+.ctx-head { padding: 8px 12px 6px; font-size: 12px; font-weight: 600; opacity: .55; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.ctx-item {
+  display: flex; align-items: center; gap: 10px; width: 100%;
+  padding: 9px 12px; border: 0; border-radius: 10px; background: transparent; cursor: pointer;
+  font-size: 13.5px; text-align: left; color: #fff;
+}
+.ctx-item .ci { width: 18px; text-align: center; opacity: .8; flex: none; }
+.ctx-item:hover:not(:disabled) { background: rgba(255, 255, 255, .14); }
+.ctx-item:disabled { opacity: .45; cursor: default; }
+.ctx-item.danger { color: #ff8a80; }
+.ctx-item.danger.armed { background: #ff453a; color: #fff; }
+.ctx-sep { height: 1px; margin: 5px 8px; background: rgba(255, 255, 255, .12); }
+@keyframes ctxIn { from { opacity: 0; transform: scale(.94); } }
+
+/* ============ Edit dialog ============ */
+#editDlg { z-index: 60; }
+.edit-sheet { width: min(460px, 92vw); padding: 24px 26px 22px; border-radius: 28px; background: rgba(28, 28, 38, .6); }
+.edit-sheet .sheet-head { margin-bottom: 16px; }
+.edit-field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; font-size: 12.5px; font-weight: 600; letter-spacing: .04em; opacity: .95; }
+.edit-field > span { opacity: .65; text-transform: uppercase; }
+.edit-field input[type=text] { width: 100%; padding: 11px 14px; font-size: 14.5px; font-weight: 400; letter-spacing: 0; }
+.edit-actions { display: flex; gap: 10px; margin-top: 6px; }
+.edit-actions .btn { flex: 1; }
+.fine.err { color: #ff8a80; opacity: 1; margin: -4px 0 8px; }
